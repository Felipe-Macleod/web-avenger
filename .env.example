# Copie para `.env` (não versionado) e preencha.
#
# client_id do app OAuth do itch.io, usado em Configurações → Apps conectados.
# Registre o app em https://itch.io/user/settings/oauth-apps com a redirect URI:
#   http://127.0.0.1/web-avenger/oauth/callback
# O valor é embutido no binário no build; definir ITCH_CLIENT_ID ao rodar o app
# sobrescreve o valor embutido.
ITCH_CLIENT_ID=
